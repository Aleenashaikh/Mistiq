# ── API ───────────────────────────────────────────────────────────────
VITE_API_TARGET=http://localhost:5000/

# ── Meta Pixel ────────────────────────────────────────────────────────
# Pixel ID from https://business.facebook.com → Events Manager
# Leave blank to disable pixel (app will not crash)
VITE_FB_PIXEL_ID=

# ── Google Search Console ─────────────────────────────────────────────
# Paste the content value from GSC HTML-tag verification
# Leave blank until you have a verification token
VITE_GSC_VERIFICATION=

# ── Google Analytics 4 ────────────────────────────────────────────────
# Measurement ID from GA4 (e.g. G-XXXXXXXXXX)
# Leave blank to disable gtag.js (app will not crash)
VITE_GA_ID=
